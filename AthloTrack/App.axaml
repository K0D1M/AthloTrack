<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AthloTrack"
             x:Class="AthloTrack.App">
             <!-- Light/Dark follows Ρυθμίσεις → Θέμα (Services/ThemeService.cs). Surface colours come
                  from the theme tokens in Styles/Theme.axaml. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AthloTrack/Styles/Theme.axaml" />
                <ResourceInclude Source="avares://AthloTrack/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AthloTrack/Styles/Motion.axaml" />
        <StyleInclude Source="avares://AthloTrack/Styles/Admin.axaml" />

        <!-- Page background from the theme (Fluent's dark pages are pure black) -->
        <Style Selector="ContentPage">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        </Style>

        <!-- Android keyboards (Gboard, Samsung…) "compose" words and let the app replace them as
             they go; Avalonia's Android TextBox loses keystrokes doing that on slower phones (e.g.
             only "te" of "test", or nothing at all). Without suggestions the keyboard types each key
             directly, which is reliable. Cost: no word suggestions/autocorrect in AthloTrack's fields. -->
        <Style Selector="TextBox">
            <Setter Property="TextInputOptions.ShowSuggestions" Value="False" />
        </Style>

        <!-- Multi-line boxes (the workout text, notes): Avalonia doesn't tell Android they are
             multi-line, so the keyboard showed a ✓ "Done" key whose line break Avalonia added behind
             its back; Gboard then dropped the next key. Declared multi-line, it shows ⏎ instead. -->
        <Style Selector="TextBox[AcceptsReturn=True]">
            <Setter Property="TextInputOptions.Multiline" Value="True" />
            <Setter Property="TextInputOptions.ReturnKeyType" Value="Return" />
        </Style>

        <!-- Floating "+" action button. Fluent's pointer-over/pressed template states replace a
             local Background, which turned the FAB grey; restate them in brand blue. -->
        <Style Selector="Button.fab">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource BrandButtonGradient}" />
            <Setter Property="Foreground" Value="{StaticResource BrandSecondaryBrush}" />
        </Style>
        <Style Selector="Button.fab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandButtonHoverGradient}" />
            <Setter Property="Foreground" Value="{StaticResource BrandSecondaryBrush}" />
        </Style>
        <Style Selector="Button.dark">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="{StaticResource BrandSecondaryBrush}" />
        </Style>
        <Style Selector="Button.dark:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4A4A4A" />
            <Setter Property="Foreground" Value="{StaticResource BrandSecondaryBrush}" />
        </Style>
        <Style Selector="Button.dark:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1F1F1F" />
            <Setter Property="Foreground" Value="{StaticResource BrandSecondaryBrush}" />
        </Style>
        <Style Selector="Button.fab:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandButtonPressedGradient}" />
            <Setter Property="Foreground" Value="{StaticResource BrandSecondaryBrush}" />
        </Style>

        <!-- Gold camera badge on a photo -->
        <Style Selector="Button.photobadge">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{StaticResource BrandAccentGradient}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.photobadge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandAccentHoverGradient}" />
        </Style>

        <!-- Gradient pill buttons used across the app -->
        <Style Selector="Button.primary, Button.gold">
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource BrandButtonGradient}" />
            <Setter Property="Foreground" Value="{StaticResource BrandSecondaryBrush}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandButtonHoverGradient}" />
            <Setter Property="Foreground" Value="{StaticResource BrandSecondaryBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandButtonPressedGradient}" />
            <Setter Property="Foreground" Value="{StaticResource BrandSecondaryBrush}" />
        </Style>
        <Style Selector="Button.gold">
            <Setter Property="Background" Value="{StaticResource BrandAccentGradient}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.gold:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandAccentHoverGradient}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.gold:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandAccentPressedGradient}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.gold:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <!-- Disabled while saving (with the spinner): keep the brand colours, just dimmed, instead
             of Fluent's grey, which read as "broken" rather than "working". -->
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandButtonGradient}" />
            <Setter Property="Foreground" Value="{StaticResource BrandSecondaryBrush}" />
        </Style>
        <Style Selector="Button.gold:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandAccentGradient}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>

    </Application.Styles>
</Application>