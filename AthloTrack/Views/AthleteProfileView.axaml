<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AthloTrack.ViewModels"
             xmlns:models="using:AthloTrack.Core.Models"
             xmlns:controls="using:AthloTrack.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="720"
             x:Class="AthloTrack.Views.AthleteProfileView"
             x:DataType="vm:AthleteProfileViewModel">

    <UserControl.Styles>
        <!-- Small round icon buttons (edit / delete / change photo) -->
        <Style Selector="Button.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrandSupportBrush}" />
        </Style>
        <Style Selector="Button.icon.danger PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TintBrush}" />
        </Style>
        <!-- icon buttons sitting on the gradient header -->
        <Style Selector="Button.icon.onhero PathIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.icon.onhero:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF" />
        </Style>
        <!-- camera badge on the photo -->
        <Style Selector="Button.badge">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{StaticResource BrandAccentBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.badge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.menuitem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinWidth" Value="210" />
        </Style>
        <Style Selector="Button.menuitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TintBrush}" />
        </Style>
        <Style Selector="Button.dialog">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.dialog.danger">
            <Setter Property="Background" Value="#C62828" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.dialog.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B71C1C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- Month header in the grouped lists -->
        <Style Selector="Button.month">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.month:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TintBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="16" Spacing="16">

                <!-- Header: gradient card with photo, name, coach actions -->
                <Border Background="{StaticResource BrandHeroGradient}" CornerRadius="16" Padding="18"
                        BoxShadow="0 6 18 0 #2A0D47A1">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Panel Grid.Column="0" Width="76" Height="76" VerticalAlignment="Top">
                        <controls:Avatar Width="72" Height="72"
                                         BorderBrush="White" BorderThickness="3"
                                         HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Photo="{Binding Photo}" Initial="{Binding Initial}" />
                        <Button Classes="badge" IsVisible="{Binding CanChangePhoto}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Click="OnChangePhoto" ToolTip.Tip="Αλλαγή φωτογραφίας">
                            <PathIcon Data="{StaticResource CameraIcon}" Foreground="{StaticResource BrandPrimaryDarkBrush}" />
                        </Button>
                    </Panel>

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <!-- First load: the name isn't known yet -->
                        <StackPanel Spacing="8" IsVisible="{Binding ShowSkeleton}">
                            <Border Classes="skeleton" Background="#40FFFFFF" Width="160" Height="20" HorizontalAlignment="Left" />
                            <Border Classes="skeleton" Background="#40FFFFFF" Width="100" Height="12" HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBlock Text="{Binding FullName}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                                   Foreground="White" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="#CFE3FF" TextWrapping="Wrap"
                                   IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsUploadingPhoto}" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Classes="icon onhero" Command="{Binding EditAthleteCommand}" ToolTip.Tip="Επεξεργασία στοιχείων"
                                IsVisible="{Binding CanEditSelf}">
                            <PathIcon Data="{StaticResource PencilIcon}" />
                        </Button>
                        <Button Classes="icon onhero" Command="{Binding DeleteAthleteCommand}" ToolTip.Tip="Διαγραφή αθλητή"
                                IsVisible="{Binding CanEdit}">
                            <PathIcon Data="{StaticResource DeleteIcon}" />
                        </Button>
                    </StackPanel>
                </Grid>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Progress graph -->
                <TextBlock Text="Πρόοδος" FontSize="18" FontWeight="SemiBold"
                           IsVisible="{Binding HasChartData}" />
                <!-- The chart (ScottPlot) is drawn in code from the view model's data (see AthleteProfileView.axaml.cs). -->
                <Border x:Name="ChartHost" Height="240" IsVisible="{Binding HasChartData}" />

                <!-- Measurements -->
                <TextBlock Text="Μετρήσεις" FontSize="18" FontWeight="SemiBold" />
                <!-- First load: rows shaped like the measurements -->
                <StackPanel Spacing="16" IsVisible="{Binding ShowSkeleton}">
                    <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                        <Border Classes="skeleton" Width="84" Height="14" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" Spacing="6">
                            <Border Classes="skeleton" Width="170" Height="11" HorizontalAlignment="Left" />
                            <Border Classes="skeleton" Width="130" Height="11" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                        <Border Classes="skeleton" Width="84" Height="14" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" Spacing="6">
                            <Border Classes="skeleton" Width="150" Height="11" HorizontalAlignment="Left" />
                            <Border Classes="skeleton" Width="110" Height="11" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                        <Border Classes="skeleton" Width="84" Height="14" HorizontalAlignment="Left" />
                        <StackPanel Grid.Column="1" Spacing="6">
                            <Border Classes="skeleton" Width="190" Height="11" HorizontalAlignment="Left" />
                            <Border Classes="skeleton" Width="150" Height="11" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <TextBlock Text="Το γράφημα προόδου εμφανίζεται από τη δεύτερη μέτρηση."
                           FontSize="12" Foreground="{DynamicResource BrandSupportBrush}"
                           IsVisible="{Binding ShowChartHint}" />
                <!-- By month, newest first; a header opens/closes each month -->
                <ItemsControl ItemsSource="{Binding MeasurementGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MeasurementMonth">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="0,10,0,2"
                                      IsVisible="{Binding ShowYearSeparator}">
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding YearText}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <Border Grid.Column="2" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Button Classes="month" Command="{Binding ToggleCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Panel Width="18" Height="18" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource ChevronDownIcon}" Width="18" Height="18"
                                                      Foreground="{DynamicResource HeadingBrush}" IsVisible="{Binding IsExpanded}" />
                                            <PathIcon Data="{StaticResource ChevronRightIcon}" Width="18" Height="18"
                                                      Foreground="{DynamicResource HeadingBrush}" IsVisible="{Binding !IsExpanded}" />
                                        </Panel>
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource HeadingBrush}" />
                                    </StackPanel>
                                </Button>
                            <ItemsControl ItemsSource="{Binding Items}" Classes="fadeitems" IsVisible="{Binding IsExpanded}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Measurement">
                                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding MeasuredAt, StringFormat='{}{0:dd/MM/yyyy}'}"
                                                           FontWeight="SemiBold" Width="100" VerticalAlignment="Center" />
                                                <!-- WrapPanel: on a phone the three values don't fit one line. -->
                                                <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemSpacing="16" LineSpacing="2"
                                                           VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding WeightKg, StringFormat='Βάρος: {0} kg'}" />
                                                    <TextBlock Text="{Binding FatMassWt, StringFormat='Fat Mass/WT: {0}', TargetNullValue='Fat Mass/WT: —'}" />
                                                    <TextBlock Text="{Binding FatHgt, StringFormat='fat/hgt: {0}', TargetNullValue='fat/hgt: —'}" />
                                                </WrapPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                            IsVisible="{Binding $parent[UserControl].((vm:AthleteProfileViewModel)DataContext).CanEdit}">
                                                    <Button Classes="icon" ToolTip.Tip="Επεξεργασία μέτρησης"
                                                            Command="{Binding $parent[UserControl].((vm:AthleteProfileViewModel)DataContext).EditMeasurementCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{StaticResource PencilIcon}" />
                                                    </Button>
                                                    <Button Classes="icon danger" ToolTip.Tip="Διαγραφή μέτρησης"
                                                            Command="{Binding $parent[UserControl].((vm:AthleteProfileViewModel)DataContext).DeleteMeasurementCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{StaticResource DeleteIcon}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="2" IsVisible="{Binding HasNoMeasurements}">
                    <TextBlock Text="Καμία μέτρηση ακόμη." Foreground="{DynamicResource BrandSupportBrush}" />
                    <TextBlock Text="Πάτησε το + για να προσθέσεις την πρώτη." FontSize="12"
                               Foreground="{DynamicResource BrandSupportBrush}" IsVisible="{Binding CanEdit}" />
                </StackPanel>

                <!-- Workout programs -->
                <TextBlock Text="Ασκησιολόγια" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel Spacing="20" IsVisible="{Binding ShowSkeleton}">
                    <StackPanel Spacing="8">
                        <Border Classes="skeleton" Width="160" Height="14" HorizontalAlignment="Left" />
                        <Border Classes="skeleton" Height="11" />
                        <Border Classes="skeleton" Width="210" Height="11" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <Border Classes="skeleton" Width="160" Height="14" HorizontalAlignment="Left" />
                        <Border Classes="skeleton" Height="11" />
                        <Border Classes="skeleton" Width="160" Height="11" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
                <!-- By month, newest first; a header opens/closes each month -->
                <ItemsControl ItemsSource="{Binding WorkoutGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkoutMonth">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="0,10,0,2"
                                      IsVisible="{Binding ShowYearSeparator}">
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding YearText}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <Border Grid.Column="2" Height="1" Background="{DynamicResource DividerBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Button Classes="month" Command="{Binding ToggleCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Panel Width="18" Height="18" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource ChevronDownIcon}" Width="18" Height="18"
                                                      Foreground="{DynamicResource HeadingBrush}" IsVisible="{Binding IsExpanded}" />
                                            <PathIcon Data="{StaticResource ChevronRightIcon}" Width="18" Height="18"
                                                      Foreground="{DynamicResource HeadingBrush}" IsVisible="{Binding !IsExpanded}" />
                                        </Panel>
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource HeadingBrush}" />
                                    </StackPanel>
                                </Button>
                            <ItemsControl ItemsSource="{Binding Items}" Classes="fadeitems" IsVisible="{Binding IsExpanded}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:WorkoutProgram">
                                        <!-- SeenTracker: on the athlete's own profile, counts as read once on screen -->
                                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8"
                                                controls:SeenTracker.Command="{Binding $parent[UserControl].((vm:AthleteProfileViewModel)DataContext).WorkoutSeenCommand}"
                                                controls:SeenTracker.CommandParameter="{Binding}">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding TargetDate, StringFormat='Ημ. στόχος: {0:dd/MM/yyyy}'}"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                                IsVisible="{Binding $parent[UserControl].((vm:AthleteProfileViewModel)DataContext).CanEdit}">
                                                        <Button Classes="icon" ToolTip.Tip="Επεξεργασία ασκησιολογίου"
                                                                Command="{Binding $parent[UserControl].((vm:AthleteProfileViewModel)DataContext).EditWorkoutCommand}"
                                                                CommandParameter="{Binding}">
                                                            <PathIcon Data="{StaticResource PencilIcon}" />
                                                        </Button>
                                                        <Button Classes="icon danger" ToolTip.Tip="Διαγραφή ασκησιολογίου"
                                                                Command="{Binding $parent[UserControl].((vm:AthleteProfileViewModel)DataContext).DeleteWorkoutCommand}"
                                                                CommandParameter="{Binding}">
                                                            <PathIcon Data="{StaticResource DeleteIcon}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <controls:CoachPresence Present="{Binding CoachPresent}" />
                                                <controls:WorkoutText Text="{Binding Content}" />
                                                <!-- done marker (everyone) -->
                                                <TextBlock IsVisible="{Binding IsCompleted}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold"
                                                           Text="{Binding CompletedAt, StringFormat='✓ Ολοκληρώθηκε {0:dd/MM/yyyy}'}" />
                                                <!-- read receipt (coach only) -->
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <StackPanel.IsVisible>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="IsRead" />
                                                            <Binding Path="$parent[UserControl].((vm:AthleteProfileViewModel)DataContext).CanEdit" />
                                                        </MultiBinding>
                                                    </StackPanel.IsVisible>
                                                    <PathIcon Data="{StaticResource EyeIcon}" Width="14" Height="14"
                                                              Foreground="{DynamicResource BrandSupportBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ReadAtLocal, StringFormat='Διαβάστηκε από τον αθλητή στις {0:dd/MM/yyyy HH:mm}'}"
                                                               FontSize="12" Foreground="{DynamicResource BrandSupportBrush}"
                                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <!-- the athlete marks their own open workout done -->
                                                <Button Classes="primary" Content="Ολοκληρώθηκε" HorizontalAlignment="Left" Height="36"
                                                        Command="{Binding $parent[UserControl].((vm:AthleteProfileViewModel)DataContext).CompleteWorkoutCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="!IsCompleted" />
                                                            <Binding Path="$parent[UserControl].((vm:AthleteProfileViewModel)DataContext).CanCompleteWorkouts" />
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Spacing="2" IsVisible="{Binding HasNoWorkouts}">
                    <TextBlock Text="Κανένα ασκησιολόγιο ακόμη." Foreground="{DynamicResource BrandSupportBrush}" />
                    <TextBlock Text="Πάτησε το + για να προσθέσεις το πρώτο." FontSize="12"
                               Foreground="{DynamicResource BrandSupportBrush}" IsVisible="{Binding CanEdit}" />
                </StackPanel>

                <!-- spacer so FAB doesn't cover last item -->
                <Border Height="72" />
            </StackPanel>
        </ScrollViewer>
        <ProgressBar Classes="topline" IsIndeterminate="True" IsVisible="{Binding IsLoading}" />

        <!-- Floating "+" button (coach only) -->
        <!-- "+" opens an in-page menu. A MenuFlyout (popup) left the next profile's chart blank on
             Android after leaving the page, so the menu is drawn inside the page instead. -->
        <Border x:Name="AddMenuDismiss" IsVisible="False" Background="#01000000"
                PointerPressed="OnAddMenuDismiss" />
        <Border x:Name="AddMenu" IsVisible="False"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,86"
                Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="6" BoxShadow="0 8 24 0 #33000000">
            <StackPanel>
                <Button Classes="menuitem" Click="OnAddMeasurement">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource ChartLineIcon}" Foreground="{StaticResource BrandPrimaryBrush}" />
                        <TextBlock Text="Νέα μέτρηση" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="menuitem" Click="OnAddWorkout">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource DumbbellIcon}" Foreground="{StaticResource BrandPrimaryBrush}" />
                        <TextBlock Text="Νέο ασκησιολόγιο" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <Button Classes="fab"
                IsVisible="{Binding CanEdit}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,20" Click="OnToggleAddMenu">
            <PathIcon Data="{StaticResource PlusIcon}" Foreground="{StaticResource BrandSecondaryBrush}" />
        </Button>

        <!-- In-app confirmation (browser/Android have no native message box) -->
        <Grid IsVisible="{Binding IsConfirming}" Background="#66000000">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="20" Margin="16"
                    MaxWidth="380" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="18">
                    <TextBlock Text="{Binding ConfirmMessage}" TextWrapping="Wrap" FontSize="15" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Classes="dialog" Content="Άκυρο" Command="{Binding CancelConfirmCommand}" />
                        <Button Classes="dialog danger" Content="Διαγραφή" Command="{Binding ConfirmCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
