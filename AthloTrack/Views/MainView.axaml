<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AthloTrack.ViewModels"
             xmlns:controls="using:AthloTrack.Views.Controls"
             xmlns:views="using:AthloTrack.Views"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="720"
             x:Class="AthloTrack.Views.MainView"
             x:DataType="vm:MainViewModel"
             AutomaticallyApplySafeAreaPadding="False">
    <!-- AutomaticallyApplySafeAreaPadding off: the PageNavigationHost already keeps the page clear of
         the Android status and navigation bars; padding here too doubled the gap above the top bar
         and below the bottom bar. -->
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <ContentPage.Styles>
        <!-- Top bar buttons (back, avatar): no Fluent chrome on the gradient. -->
        <Style Selector="Button.bar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.bar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF" />
        </Style>
        <Style Selector="Button.bar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#40FFFFFF" />
        </Style>

        <!-- Bottom bar: filled icon + coloured label when selected, outline + muted when not. -->
        <Style Selector="ListBox#TabBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox#TabBar > ListBoxItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource BrandSupportBrush}" />
        </Style>
        <Style Selector="ListBox#TabBar > ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
        </Style>
        <Style Selector="ListBox#TabBar > ListBoxItem :is(Control).filled">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox#TabBar > ListBoxItem:selected :is(Control).filled">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ListBox#TabBar > ListBoxItem:selected :is(Control).outline">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox#TabBar Border.pill">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox#TabBar > ListBoxItem:selected Border.pill">
            <Setter Property="Background" Value="{DynamicResource TintStrongBrush}" />
        </Style>
        <Style Selector="ListBox#TabBar PathIcon, ListBox#TabBar Path">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
        </Style>
        <Style Selector="ListBox#TabBar TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style Selector="ListBox#TabBar > ListBoxItem:selected TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </ContentPage.Styles>

    <ContentPage.Resources>
        <!-- Bottom bar items: an own theme (not based on Fluent's) so there's no selection block or
             hover fill; the pill and the filled icon show the selection. -->
        <ControlTheme x:Key="TabItemTheme" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0,8,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      Padding="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SurfaceBrush}">

    <!-- Top bar: Up arrow on sub-pages, the page title, and the signed-in user's photo (opens Ρυθμίσεις). -->
    <Border x:Name="TopBar" Grid.Row="0" Background="{StaticResource BrandBarGradient}">
        <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="56" Margin="8,0">
            <Button x:Name="BackButton" Grid.Column="0" Classes="bar" IsVisible="False"
                    Click="OnBackClick" ToolTip.Tip="Πίσω">
                <PathIcon Data="{StaticResource ArrowLeftIcon}" Width="22" Height="22" />
            </Button>
            <TextBlock x:Name="TitleText" Grid.Column="1" Text="AthloTrack" Foreground="White"
                       FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="8,0" />
            <Button x:Name="AvatarButton" Grid.Column="2" Classes="bar" Padding="4"
                    Click="OnAvatarClick" ToolTip.Tip="Ρυθμίσεις">
                <controls:Avatar x:Name="TopAvatar" x:DataType="vm:CurrentUserViewModel" Width="34" Height="34"
                                 BorderBrush="White" BorderThickness="2"
                                 Photo="{Binding Photo}" Initial="{Binding Initial}" />
            </Button>
        </Grid>
    </Border>

    <ContentPage Name="ContentPage" Grid.Row="1" AutomaticallyApplySafeAreaPadding="False">
        <ContentPage.DataTemplates>
            <DataTemplate x:DataType="vm:RecentViewModel">
                <ContentPage Header="Πρόσφατα">
                    <ContentPage.Icon>
                        <PathIcon Data="{StaticResource ClockIcon}" />
                    </ContentPage.Icon>
                    <Grid>
                    <ScrollViewer>
                        <StackPanel Margin="16,20" Spacing="16">
                            <!-- Gradient welcome banner -->
                            <Border Background="{StaticResource BrandHeroGradient}" CornerRadius="16"
                                    Padding="24,22" BoxShadow="0 6 18 0 #2A0D47A1">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding WelcomeMessage}" FontSize="26" FontWeight="Bold"
                                               Foreground="White" TextWrapping="Wrap" />
                                    <TextBlock Text="Καλή προπόνηση!" FontSize="14" Foreground="#CFE3FF" />
                                </StackPanel>
                            </Border>

                            <!-- Web: offer notifications until they're on (iPhone: after adding to the Home Screen) -->
                            <Border IsVisible="{Binding Push.ShowBanner}" Background="{DynamicResource NoticeBrush}" CornerRadius="14" Padding="16"
                                    BorderBrush="#FFD700" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Ειδοποιήσεις στο κινητό" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Push.StatusText}" FontSize="13" TextWrapping="Wrap" />
                                    <Button Classes="primary" Content="Ενεργοποίηση" HorizontalAlignment="Left" Height="38"
                                            Command="{Binding Push.EnableCommand}" IsVisible="{Binding Push.CanEnable}" />
                                </StackPanel>
                            </Border>

                            <!-- First load: placeholders shaped like the card and the notifications -->
                            <StackPanel Spacing="16" IsVisible="{Binding ShowSkeleton}">
                                <Border Background="{DynamicResource TintBrush}" CornerRadius="14" Padding="16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Border Classes="skeleton circle" Width="52" Height="52" />
                                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                            <Border Classes="skeleton" Width="110" Height="10" HorizontalAlignment="Left" />
                                            <Border Classes="skeleton" Width="170" Height="16" HorizontalAlignment="Left" />
                                            <Border Classes="skeleton" Width="140" Height="10" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel Spacing="8">
                                    <Border Classes="skeleton" Width="110" Height="16" HorizontalAlignment="Left" />
                                    <Border Classes="skeleton" Height="44" CornerRadius="8" />
                                    <Border Classes="skeleton" Height="44" CornerRadius="8" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Coach: most recent athlete card -->
                            <Border Classes="appear-shown" Classes.shown="{Binding !ShowSkeleton}"
                                    Background="{DynamicResource CardTintGradient}" CornerRadius="14" Padding="16"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                <Border.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsCoach" />
                                        <Binding Path="!ShowSkeleton" />
                                    </MultiBinding>
                                </Border.IsVisible>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <controls:Avatar Grid.Column="0" Width="52" Height="52" VerticalAlignment="Center"
                                                     IsVisible="{Binding HasRecentAthlete}" CanPreview="True"
                                                     Photo="{Binding RecentAthletePhoto}"
                                                     Initial="{Binding RecentAthleteInitial}" />
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="Πιο πρόσφατος αθλητής" FontSize="12"
                                                   Foreground="{DynamicResource BrandSupportBrush}" />
                                        <TextBlock Text="{Binding RecentAthleteName}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RecentAthleteSummary}" FontSize="13"
                                                   Foreground="{DynamicResource BrandSupportBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Athlete: their coach -->
                            <Border IsVisible="{Binding HasCoach}" Classes="appear-shown" Classes.shown="{Binding HasCoach}"
                                    Background="{DynamicResource CardTintGradient}" CornerRadius="14" Padding="16"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <controls:Avatar Grid.Column="0" Width="52" Height="52" VerticalAlignment="Center" CanPreview="True"
                                                     Photo="{Binding CoachPhoto}" Initial="{Binding CoachInitial}" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Ο προπονητής σου" FontSize="12"
                                                   Foreground="{DynamicResource BrandSupportBrush}" />
                                        <TextBlock Text="{Binding CoachName}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Unread notifications: athletes (new workout) and coaches (workout completed) -->
                            <StackPanel Spacing="8" IsVisible="{Binding !ShowSkeleton}">
                                <TextBlock Text="Ειδοποιήσεις" FontSize="16" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Notifications}" Classes="fadeitems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource NoticeBrush}" CornerRadius="8" Padding="4" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <!-- Tap: open the workout it's about (and mark it read) -->
                                                    <Button Grid.Column="0" Background="Transparent" Padding="8"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                            Command="{Binding $parent[ItemsControl].((vm:RecentViewModel)DataContext).OpenNotificationCommand}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding CreatedAt, Converter={x:Static vm:TimeConverters.Stamp}}"
                                                                       FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1" Content="✓" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            ToolTip.Tip="Αναγνώστηκε"
                                                            Command="{Binding $parent[ItemsControl].((vm:RecentViewModel)DataContext).MarkReadCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Καμία νέα ειδοποίηση."
                                           Foreground="{DynamicResource BrandSupportBrush}"
                                           IsVisible="{Binding !Notifications.Count}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <ProgressBar Classes="topline" IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
                    </Grid>
                </ContentPage>
            </DataTemplate>

            <DataTemplate x:DataType="vm:AthletesViewModel">
                <ContentPage Header="Αθλητές">
                    <ContentPage.Icon>
                        <PathIcon Data="{StaticResource PersonIcon}" />
                    </ContentPage.Icon>
                    <Grid>
                        <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Athletes}" Margin="8,8,8,88" Classes="fadeitems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AthleteListItemViewModel">
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            Padding="12"
                                            Command="{Binding $parent[ItemsControl].((vm:AthletesViewModel)DataContext).OpenAthleteCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <controls:Avatar Grid.Column="0" Width="44" Height="44"
                                                             Photo="{Binding Photo}" Initial="{Binding Initial}" />
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                           Foreground="{DynamicResource BrandSupportBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>

                        <!-- First load: rows shaped like the athlete list -->
                        <StackPanel Margin="20,20,20,0" Spacing="22" IsVisible="{Binding ShowSkeleton}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Classes="skeleton circle" Width="44" Height="44" />
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Border Classes="skeleton" Width="180" Height="14" HorizontalAlignment="Left" />
                                    <Border Classes="skeleton" Width="130" Height="10" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Classes="skeleton circle" Width="44" Height="44" />
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Border Classes="skeleton" Width="150" Height="14" HorizontalAlignment="Left" />
                                    <Border Classes="skeleton" Width="100" Height="10" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Classes="skeleton circle" Width="44" Height="44" />
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Border Classes="skeleton" Width="200" Height="14" HorizontalAlignment="Left" />
                                    <Border Classes="skeleton" Width="150" Height="10" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Classes="skeleton circle" Width="44" Height="44" />
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Border Classes="skeleton" Width="130" Height="14" HorizontalAlignment="Left" />
                                    <Border Classes="skeleton" Width="80" Height="10" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Classes="skeleton circle" Width="44" Height="44" />
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Border Classes="skeleton" Width="170" Height="14" HorizontalAlignment="Left" />
                                    <Border Classes="skeleton" Width="120" Height="10" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Δεν υπάρχουν αθλητές ακόμη."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrandSupportBrush}">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!Athletes.Count" />
                                    <Binding Path="!IsLoading" />
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>

                        <Button Classes="fab"
                                IsVisible="{Binding CanEdit}"
                                Command="{Binding AddAthleteCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,20,20">
                            <PathIcon Data="{StaticResource PlusIcon}" Foreground="{StaticResource BrandSecondaryBrush}" />
                        </Button>
                        <ProgressBar Classes="topline" IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
                    </Grid>
                </ContentPage>
            </DataTemplate>

            <DataTemplate x:DataType="vm:WorkoutsViewModel">
                <ContentPage Header="Προπονήσεις">
                    <ContentPage.Icon>
                        <PathIcon Data="{StaticResource DumbbellIcon}" />
                    </ContentPage.Icon>
                    <Grid>
                        <ScrollViewer>
                            <StackPanel>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                       Margin="16,12,16,0"
                                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding InfoMessage}" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"
                                       Margin="16,12,16,0"
                                       IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <ItemsControl ItemsSource="{Binding WorkoutPrograms}" Margin="12" Classes="fadeitems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkoutListItemViewModel">
                                        <!-- SeenTracker: an athlete's workout counts as read once on screen -->
                                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="4,10"
                                                controls:SeenTracker.Command="{Binding $parent[ItemsControl].((vm:WorkoutsViewModel)DataContext).WorkoutSeenCommand}"
                                                controls:SeenTracker.CommandParameter="{Binding}">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding AthleteName}" FontWeight="SemiBold" FontSize="15"
                                                               VerticalAlignment="Center" />
                                                    <!-- Coach: ask the athlete whether it was done -->
                                                    <Button Grid.Column="1" Classes="iconbutton" ToolTip.Tip="Υπενθύμιση στον αθλητή"
                                                            IsVisible="{Binding CanRemind}" IsEnabled="{Binding RemindEnabled}"
                                                            Command="{Binding $parent[ItemsControl].((vm:WorkoutsViewModel)DataContext).RemindWorkoutCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Data="{StaticResource BellRingIcon}" Width="18" Height="18"
                                                                  Foreground="{DynamicResource BrandSupportBrush}" />
                                                    </Button>
                                                </Grid>
                                                <TextBlock Text="{Binding TargetDateText}" FontSize="12"
                                                           Foreground="{DynamicResource BrandSupportBrush}" />
                                                <controls:CoachPresence Present="{Binding Program.CoachPresent}" Margin="0,2,0,0" />
                                                <controls:WorkoutText Text="{Binding Content}" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding CompletedText}" IsVisible="{Binding IsCompleted}"
                                                           Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding NotCompletedText}" IsVisible="{Binding IsNotCompleted}"
                                                           Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                                                            IsVisible="{Binding ShowReminderSent}">
                                                    <PathIcon Data="{StaticResource BellRingIcon}" Width="14" Height="14"
                                                              Foreground="{DynamicResource BrandSupportBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ReminderText}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource BrandSupportBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                                                            IsVisible="{Binding ShowReadReceipt}">
                                                    <PathIcon Data="{StaticResource EyeIcon}" Width="14" Height="14"
                                                              Foreground="{DynamicResource BrandSupportBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ReadText}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource BrandSupportBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <!-- the athlete answers an open workout (final; the coach is notified) -->
                                                <WrapPanel Margin="0,6,0,0" IsVisible="{Binding CanComplete}">
                                                    <Button Classes="primary answer" Margin="0,0,8,6"
                                                            Command="{Binding $parent[ItemsControl].((vm:WorkoutsViewModel)DataContext).CompleteWorkoutCommand}" CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <PathIcon Data="{StaticResource CheckCircleIcon}" />
                                                            <TextBlock Text="Ολοκληρώθηκε" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Classes="answer notdone" Margin="0,0,8,6"
                                                            Command="{Binding $parent[ItemsControl].((vm:WorkoutsViewModel)DataContext).NotCompleteWorkoutCommand}" CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <PathIcon Data="{StaticResource CloseCircleIcon}" />
                                                            <TextBlock Text="Δεν ολοκληρώθηκε" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- First load: cards shaped like the workouts -->
                        <StackPanel Margin="16,22,16,0" Spacing="26" IsVisible="{Binding ShowSkeleton}">
                            <StackPanel Spacing="8">
                                <Border Classes="skeleton" Width="150" Height="14" HorizontalAlignment="Left" />
                                <Border Classes="skeleton" Width="100" Height="10" HorizontalAlignment="Left" />
                                <Border Classes="skeleton" Height="12" Margin="0,4,0,0" />
                                <Border Classes="skeleton" Width="220" Height="12" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <Border Classes="skeleton" Width="150" Height="14" HorizontalAlignment="Left" />
                                <Border Classes="skeleton" Width="100" Height="10" HorizontalAlignment="Left" />
                                <Border Classes="skeleton" Height="12" Margin="0,4,0,0" />
                                <Border Classes="skeleton" Width="160" Height="12" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <Border Classes="skeleton" Width="150" Height="14" HorizontalAlignment="Left" />
                                <Border Classes="skeleton" Width="100" Height="10" HorizontalAlignment="Left" />
                                <Border Classes="skeleton" Height="12" Margin="0,4,0,0" />
                                <Border Classes="skeleton" Width="250" Height="12" HorizontalAlignment="Left" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Δεν υπάρχουν ασκησιολόγια ακόμη."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrandSupportBrush}">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!WorkoutPrograms.Count" />
                                    <Binding Path="!IsLoading" />
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>
                        <ProgressBar Classes="topline" IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
                        <views:ConfirmOverlay DataContext="{Binding Confirm}" />
                    </Grid>
                </ContentPage>
            </DataTemplate>

            <DataTemplate x:DataType="vm:CalendarViewModel">
                <ContentPage Header="Ημερολόγιο">
                    <ContentPage.Icon>
                        <PathIcon Data="{StaticResource CalendarIcon}" />
                    </ContentPage.Icon>
                    <ContentPage.Styles>
                        <Style Selector="Button.calday">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="Padding" Value="2,4" />
                            <Setter Property="Margin" Value="1" />
                            <Setter Property="Height" Value="60" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                        </Style>
                        <Style Selector="Button.calday.othermonth">
                            <Setter Property="Opacity" Value="0.4" />
                        </Style>
                        <Style Selector="Button.calday:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource TintBrush}" />
                        </Style>
                        <Style Selector="Button.calday.today /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
                            <Setter Property="BorderThickness" Value="1.5" />
                        </Style>
                        <Style Selector="Button.calday.selected /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{StaticResource BrandButtonGradient}" />
                            <Setter Property="Foreground" Value="{StaticResource BrandSecondaryBrush}" />
                        </Style>
                        <Style Selector="Button.calnav">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Width" Value="40" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="CornerRadius" Value="20" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                        <Style Selector="Button.agenda">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,10" />
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </ContentPage.Styles>

                    <Grid>
                    <ScrollViewer>
                        <StackPanel Margin="12" Spacing="10" MaxWidth="560" HorizontalAlignment="Stretch">

                            <!-- month header -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Grid.Column="0" Classes="calnav" Command="{Binding PreviousMonthCommand}">
                                    <TextBlock Text="‹" FontSize="22" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding MonthTitle}" FontSize="18" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource HeadingBrush}" />
                                <Button Grid.Column="2" Classes="calnav" Command="{Binding NextMonthCommand}">
                                    <TextBlock Text="›" FontSize="22" />
                                </Button>
                            </Grid>

                            <!-- weekday names, Monday first -->
                            <ItemsControl ItemsSource="{Binding WeekdayNames}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource BrandSupportBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- month grid: photos of the athletes with a workout that day -->
                            <ItemsControl ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CalendarDayViewModel">
                                        <Button Classes="calday"
                                                Classes.selected="{Binding IsSelected}"
                                                Classes.today="{Binding IsToday}"
                                                Classes.othermonth="{Binding !IsCurrentMonth}"
                                                Command="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).SelectDayCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DayNumber}" FontSize="13" HorizontalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center"
                                                            IsVisible="{Binding HasWorkouts}">
                                                    <ItemsControl ItemsSource="{Binding Avatars}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:CalendarEntryViewModel">
                                                                <controls:Avatar Width="20" Height="20"
                                                                                 BorderBrush="White" BorderThickness="1"
                                                                                 Photo="{Binding Photo}" Initial="{Binding Initial}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding MoreText}" IsVisible="{Binding HasMore}"
                                                               FontSize="10" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- agenda: the selected day, or the whole month -->
                            <TextBlock Text="{Binding AgendaTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />

                            <!-- First load: agenda rows -->
                            <StackPanel Spacing="18" Margin="4,4,0,0" IsVisible="{Binding ShowSkeleton}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Classes="skeleton circle" Width="40" Height="40" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <Border Classes="skeleton" Width="140" Height="13" HorizontalAlignment="Left" />
                                        <Border Classes="skeleton" Width="90" Height="10" HorizontalAlignment="Left" />
                                        <Border Classes="skeleton" Width="230" Height="11" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Classes="skeleton circle" Width="40" Height="40" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <Border Classes="skeleton" Width="140" Height="13" HorizontalAlignment="Left" />
                                        <Border Classes="skeleton" Width="90" Height="10" HorizontalAlignment="Left" />
                                        <Border Classes="skeleton" Width="180" Height="11" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Classes="skeleton circle" Width="40" Height="40" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <Border Classes="skeleton" Width="140" Height="13" HorizontalAlignment="Left" />
                                        <Border Classes="skeleton" Width="90" Height="10" HorizontalAlignment="Left" />
                                        <Border Classes="skeleton" Width="210" Height="11" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding AgendaEntries}" Classes="fadeitems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CalendarEntryViewModel">
                                        <Button Classes="agenda"
                                                Command="{Binding $parent[ItemsControl].((vm:CalendarViewModel)DataContext).OpenEntryCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                <controls:Avatar Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top"
                                                                 Photo="{Binding Photo}" Initial="{Binding Initial}" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding AthleteName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DateText}" FontSize="12"
                                                               Foreground="{DynamicResource BrandSupportBrush}" />
                                                    <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap"
                                                               MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Καμία προπόνηση για αυτό το διάστημα."
                                       Foreground="{DynamicResource BrandSupportBrush}"
                                       IsVisible="{Binding HasNoAgendaEntries}" />
                        </StackPanel>
                    </ScrollViewer>
                    <ProgressBar Classes="topline" IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
                    </Grid>
                </ContentPage>
            </DataTemplate>

            <DataTemplate x:DataType="vm:AboutViewModel">
                <ContentPage Header="Σχετικά">
                    <ContentPage.Icon>
                        <PathIcon Data="{StaticResource InfoIcon}" />
                    </ContentPage.Icon>
                    <ScrollViewer>
                    <StackPanel Margin="24" Spacing="10" HorizontalAlignment="Center" MaxWidth="420">
                        <Border Width="72" Height="72" CornerRadius="22" HorizontalAlignment="Center"
                                Background="{StaticResource BrandLogoGradient}">
                            <PathIcon Data="{StaticResource LogoIcon}" Width="36" Height="36"
                                      Foreground="{StaticResource BrandPrimaryDarkBrush}" />
                        </Border>
                        <TextBlock Text="{Binding AppName}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Version, StringFormat='Έκδοση {0}'}" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource BrandSupportBrush}" />
                        <Border IsVisible="{Binding IsPreRelease}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                Background="{DynamicResource NoticeBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="12,8">
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                                       Text="Δοκιμαστική έκδοση (alpha): μπορεί να υπάρχουν σφάλματα και αλλαγές." />
                        </Border>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                   Text="Παρακολούθηση προόδου αθλητών: μετρήσεις, ασκησιολόγια και γραφήματα προόδου, για προπονητές και αθλητές." />
                        <TextBlock Text="νοῦς ὑγιής ἐν σώματι ὑγιεῖ" FontStyle="Italic" HorizontalAlignment="Center"
                                   FontFamily="{StaticResource GreekAccentFont}"
                                   Margin="0,8,0,0" Foreground="{DynamicResource HeadingBrush}" />

                        <!-- Credits -->
                        <TextBlock Text="Δημιουργία" FontWeight="SemiBold" Margin="0,20,0,0"
                                   Foreground="{DynamicResource HeadingBrush}" />
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Σχεδιασμός και ανάπτυξη: K0D1M" TextWrapping="Wrap" />
                                <TextBlock Text="Με τη βοήθεια του Claude (Anthropic)." TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Λογισμικό ανοιχτού κώδικα" FontWeight="SemiBold" Margin="0,12,0,0"
                                   Foreground="{DynamicResource HeadingBrush}" />
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,8">
                            <ItemsControl ItemsSource="{Binding Credits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CreditItem">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Use}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding License}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Ευχαριστούμε τους δημιουργούς τους. Κάθε μέρος διέπεται από τη δική του άδεια χρήσης." />

                        <!-- Legal -->
                        <TextBlock Text="Νομικά" FontWeight="SemiBold" Margin="0,12,0,0"
                                   Foreground="{DynamicResource HeadingBrush}" />
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <StackPanel Spacing="10">
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Text="Άδεια χρήσης: PolyForm Strict 1.0.0. Επιτρέπεται μόνο μη εμπορική χρήση· δεν επιτρέπεται η αναδιανομή ή η τροποποίηση της εφαρμογής." />
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Text="Η εφαρμογή παρέχεται «ως έχει», χωρίς καμία εγγύηση. Ο δημιουργός δεν ευθύνεται για ζημίες από τη χρήση της." />
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Text="Δεν αποτελεί ιατρική συμβουλή. Συμβουλέψου γιατρό πριν ξεκινήσεις ή αλλάξεις πρόγραμμα άσκησης." />
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Text="Δεδομένα: οι λογαριασμοί, οι μετρήσεις, τα ασκησιολόγια και οι φωτογραφίες αποθηκεύονται στη Supabase και χρησιμοποιούνται μόνο για τη λειτουργία της εφαρμογής." />
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="Τα ονόματα και τα σήματα τρίτων ανήκουν στους κατόχους τους." />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Copyright}" HorizontalAlignment="Center" FontSize="12" Margin="0,12,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="Vibe-coded with ❤️ by K0D1M" HorizontalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource BrandSupportBrush}" />
                    </StackPanel>
                    </ScrollViewer>
                </ContentPage>
            </DataTemplate>

            <DataTemplate x:DataType="vm:SettingsViewModel">
                <ContentPage Header="Ρυθμίσεις">
                    <ContentPage.Icon>
                        <PathIcon Data="{StaticResource GearIcon}" />
                    </ContentPage.Icon>
                    <StackPanel Margin="16,24" Spacing="16" MaxWidth="360" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Panel Grid.Column="0" Width="68" Height="68">
                                <controls:Avatar Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top" CanPreview="True"
                                                 Photo="{Binding User.Photo}" Initial="{Binding User.Initial}" />
                                <Button Classes="photobadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding User.CanChangePhoto}"
                                        Click="OnChangeOwnPhoto" ToolTip.Tip="Αλλαγή φωτογραφίας">
                                    <PathIcon Data="{StaticResource CameraIcon}" Foreground="{StaticResource BrandPrimaryDarkBrush}" />
                                </Button>
                            </Panel>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Συνδεδεμένος ως" FontSize="12" Foreground="{DynamicResource BrandSupportBrush}" />
                                <TextBlock Text="{Binding User.DisplayName}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding User.RoleText}" FontSize="12" Foreground="{DynamicResource BrandSupportBrush}" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding User.IsUploading}" />
                        <TextBlock Text="{Binding User.ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   IsVisible="{Binding User.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <!-- Web (and iPhone from the Home Screen): notifications need a tap to allow. -->
                        <StackPanel Spacing="6" IsVisible="{Binding Push.IsAvailable}">
                            <TextBlock Text="Ειδοποιήσεις" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Push.StatusText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrandSupportBrush}" />
                            <Button Classes="primary" Content="Ενεργοποίηση ειδοποιήσεων" HorizontalAlignment="Left"
                                    Height="40" Command="{Binding Push.EnableCommand}" IsVisible="{Binding Push.CanEnable}" />
                        </StackPanel>

                        <!-- Light/Dark, remembered on this device; "Σύστημα" follows the phone/computer. -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Θέμα" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton GroupName="theme" Content="Σύστημα" IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" />
                                <RadioButton GroupName="theme" Content="Ανοιχτό" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                                <RadioButton GroupName="theme" Content="Σκούρο" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Athletes: ask before the (final) answer to a workout -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsAthlete}">
                            <TextBlock Text="Ασκησιολόγια" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Επιβεβαίωση ολοκλήρωσης" />
                                    <TextBlock Text="«Σίγουρα;» πριν από το «Ολοκληρώθηκε» ή το «Δεν ολοκληρώθηκε»."
                                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource BrandSupportBrush}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfirmAnswers, Mode=TwoWay}"
                                              OnContent="" OffContent="" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <!-- Greek only until translations (.resx) exist; a live toggle would change nothing. -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Γλώσσα / Language" FontWeight="SemiBold" />
                            <ComboBox SelectedIndex="0" IsEnabled="False" HorizontalAlignment="Stretch">
                                <ComboBoxItem>Ελληνικά</ComboBoxItem>
                                <ComboBoxItem>English</ComboBoxItem>
                            </ComboBox>
                            <TextBlock Text="Η αγγλική έκδοση έρχεται σύντομα." FontSize="12"
                                       Foreground="{DynamicResource BrandSupportBrush}" />
                        </StackPanel>

                        <!-- Σχετικά is a sub-page of Ρυθμίσεις (Up arrow / Android back return here). -->
                        <Button Click="OnOpenAbout" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Background="{DynamicResource TintBrush}" CornerRadius="12" Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <PathIcon Data="{StaticResource InfoIcon}" Width="20" Height="20"
                                          Foreground="{DynamicResource HeadingBrush}" />
                                <TextBlock Grid.Column="1" Text="Σχετικά" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <PathIcon Grid.Column="2" Data="{StaticResource ChevronRightIcon}" Width="18" Height="18"
                                          Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                        </Button>

                        <Button Classes="dark" Content="Αποσύνδεση" Command="{Binding LogoutCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Height="44" Margin="0,12,0,0" CornerRadius="22" FontWeight="SemiBold" />
                    </StackPanel>
                </ContentPage>
            </DataTemplate>
        </ContentPage.DataTemplates>
    </ContentPage>

    <!-- Bottom bar: the role's five sections (see MainView.axaml.cs). -->
    <Border x:Name="BottomBar" Grid.Row="2" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
        <ListBox Name="TabBar"
                 ItemContainerTheme="{StaticResource TabItemTheme}"
                 SelectionMode="AlwaysSelected"
                 SelectionChanged="TabBar_SelectionChanged"
                 Tapped="TabBar_Tapped">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="5" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <!-- Items: built in MainView.axaml.cs from the role's tabs (coach/athlete or admin). -->
        </ListBox>
    </Border>

    <!-- A tapped photo, large (PhotoPreview). Tapping anywhere, or back, closes it. -->
    <Grid x:Name="PhotoOverlay" Grid.RowSpan="3" IsVisible="False" Background="#D9000000"
          Tapped="OnPhotoOverlayTapped" Cursor="Hand">
        <Border x:Name="PhotoFrame" CornerRadius="16" ClipToBounds="True" HorizontalAlignment="Center"
                VerticalAlignment="Center" BoxShadow="0 10 40 0 #66000000">
            <Image x:Name="PhotoImage" Stretch="Uniform" />
        </Border>
    </Grid>
    </Grid>
</ContentPage>
