<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AthloTrack.ViewModels"
             xmlns:controls="using:AthloTrack.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="720"
             x:Class="AthloTrack.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <UserControl.Styles>
        <Style Selector="Button.login">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="23" />
        </Style>

        <!-- Step 1: the two role cards -->
        <Style Selector="Button.rolecard">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="12,20" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style Selector="Button.rolecard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TintBrush}" />
        </Style>
        <Style Selector="Button.rolecard:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TintStrongBrush}" />
        </Style>
        <Style Selector="Button.rolecard TextBlock.title">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource BrandSupportBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.rolecard TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <!-- Step 1: outlined "new athlete" pill on the gradient -->
        <Style Selector="Button.signup">
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#80FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="23" />
            <Setter Property="Height" Value="46" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.signup:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.signup:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4DFFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Step 2: back arrow in the form header -->
        <Style Selector="Button.back">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource BrandSupportBrush}" />
        </Style>
        <Style Selector="Button.back:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TintBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BrandSupportBrush}" />
        </Style>
        <Style Selector="Button.back:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" Background="{StaticResource BrandHeroGradient}">

        <!-- Soft glows for depth -->
        <Ellipse Grid.RowSpan="2" Width="520" Height="520" Opacity="0.18"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-240,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Grid.RowSpan="2" Width="440" Height="440" Opacity="0.22"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-180,-200"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFFD700" Offset="0" />
                    <GradientStop Color="#00FFD700" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Stretch + MaxWidth: fixed-width form on desktop, 16px gutters on a phone. -->
        <StackPanel x:Name="Content" Grid.Row="0"
                    MaxWidth="380"
                    Margin="16,24"
                    Spacing="18"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">

            <Border Width="88" Height="88" CornerRadius="26"
                    Background="{StaticResource BrandLogoGradient}"
                    BoxShadow="0 8 24 0 #40000000"
                    HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource LogoIcon}" Width="44" Height="44"
                          Foreground="{StaticResource BrandPrimaryDarkBrush}" />
            </Border>

            <StackPanel Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="AthloTrack" FontSize="32" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="Παρακολούθηση προόδου αθλητών" FontSize="14"
                           Foreground="#CFE3FF" HorizontalAlignment="Center" />
                <!-- Release stage from <Version> in AthloTrack.csproj (e.g. 1.10-alpha); hidden for a stable release. -->
                <Border IsVisible="{x:Static vm:AppInfo.IsPreRelease}" HorizontalAlignment="Center" Margin="0,6,0,0"
                        Background="#40FFFFFF" CornerRadius="8" Padding="8,2">
                    <TextBlock Text="{x:Static vm:AppInfo.Stage}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                </Border>
            </StackPanel>

            <!-- Step 1: who is logging in (decides which profile the login is checked against) -->
            <StackPanel Spacing="14" IsVisible="{Binding IsChoosingRole}"
                        Classes="appear-shown" Classes.shown="{Binding IsChoosingRole}">
                <TextBlock Text="Σύνδεση ως..." FontSize="16" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0" Classes="rolecard"
                            Command="{Binding ChooseCoachCommand}"
                            AutomationProperties.Name="Προπονητής">
                        <StackPanel Spacing="10">
                            <Border Width="60" Height="60" CornerRadius="30"
                                    Background="{StaticResource BrandButtonGradient}"
                                    HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource WhistleIcon}" Width="30" Height="30"
                                          Foreground="White" />
                            </Border>
                            <TextBlock Classes="title" Text="Προπονητής" />
                            <TextBlock Classes="hint" Text="Αθλητές, μετρήσεις και προγράμματα" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Classes="rolecard"
                            Command="{Binding ChooseAthleteCommand}"
                            AutomationProperties.Name="Αθλητής">
                        <StackPanel Spacing="10">
                            <Border Width="60" Height="60" CornerRadius="30"
                                    Background="{StaticResource BrandAccentGradient}"
                                    HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource RunnerIcon}" Width="30" Height="30"
                                          Foreground="{StaticResource OnAccentBrush}" />
                            </Border>
                            <TextBlock Classes="title" Text="Αθλητής" />
                            <TextBlock Classes="hint" Text="Οι προπονήσεις και η πρόοδός μου" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Button Classes="signup" Command="{Binding ChooseSignUpCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource AccountPlusIcon}" Width="18" Height="18" />
                        <TextBlock Text="Νέος αθλητής; Δημιουργία λογαριασμού" FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Shown while a saved session is being restored -->
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            </StackPanel>

            <!-- Step 2: the form for the chosen role -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="18" Padding="20"
                    BoxShadow="0 12 32 0 #33000000"
                    IsVisible="{Binding IsForm}"
                    Classes="appear-shown" Classes.shown="{Binding IsForm}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="-8,-6,0,0">
                        <Button Classes="back" Command="{Binding BackCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                AutomationProperties.Name="Πίσω"
                                ToolTip.Tip="Πίσω">
                            <PathIcon Data="{StaticResource ArrowLeftIcon}" Width="20" Height="20" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding FormTitle}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource BrandSupportBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock FontSize="12" Foreground="{DynamicResource BrandSupportBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding IsSignUp}"
                               Text="Χρησιμοποίησε το email που έδωσες στον προπονητή σου, ώστε ο λογαριασμός να συνδεθεί με το προφίλ σου." />

                    <!-- (No ContentType="Email": combined with ShowSuggestions=False from App.axaml it
                         gives an input type in which Gboard composes again; see App.axaml.) -->
                    <TextBox x:Name="EmailBox" PlaceholderText="Email"
                             Text="{Binding Email, Mode=TwoWay}"
                             UseFloatingPlaceholder="True" />

                    <TextBox PlaceholderText="Κωδικός"
                             PasswordChar="●"
                             Text="{Binding Password, Mode=TwoWay}"
                             UseFloatingPlaceholder="True"
                             TextInputOptions.IsSensitive="True">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <TextBlock Text="{Binding InfoMessage}"
                               Foreground="{StaticResource BrandPrimaryBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Blue for the coach, gold for the athlete forms (like the role cards) -->
                    <Button Classes="primary login"
                            Command="{Binding SubmitCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            IsVisible="{Binding IsCoachForm}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><controls:Spinner IsVisible="{Binding IsBusy}" VerticalAlignment="Center" /><TextBlock Text="{Binding SubmitText}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="gold login"
                            Command="{Binding SubmitCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            IsVisible="{Binding !IsCoachForm}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"><controls:Spinner IsVisible="{Binding IsBusy}" VerticalAlignment="Center" /><TextBlock Text="{Binding SubmitText}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Bottom-center Greek motto -->
        <TextBlock x:Name="Motto" Grid.Row="1"
                   Text="νοῦς ὑγιής ἐν σώματι ὑγιεῖ"
                   FontFamily="{StaticResource GreekAccentFont}"
                   FontStyle="Italic"
                   FontSize="20"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,24" />
    </Grid>
</UserControl>
