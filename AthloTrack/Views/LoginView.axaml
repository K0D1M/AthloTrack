<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AthloTrack.ViewModels"
             xmlns:controls="using:AthloTrack.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="800"
             x:Class="AthloTrack.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <!-- One screen: the brand band (or, on a wide window, the brand half) and the card. The card's
         step (σύνδεση, νέος λογαριασμός, ξέχασα τον κωδικό, κωδικός, επιβεβαίωση email) comes
         from LoginViewModel.Step. Wide or narrow is set in code (LoginView.axaml.cs). -->
    <UserControl.Styles>
        <Style Selector="Button.login">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="50" />
            <Setter Property="CornerRadius" Value="25" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- Text links: «Ξέχασα τον κωδικό», «Δημιουργία λογαριασμού» (44 px tall for a finger) -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
        </Style>
        <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TintBrush}" />
        </Style>
        <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>

        <!-- ← in the card's title -->
        <Style Selector="Button.back">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
        </Style>
        <Style Selector="Button.back:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TintBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- The code from the email (6 to 8 digits): one box, large and spaced (pasting «6479 4670» works) -->
        <Style Selector="TextBox.code">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="8" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="MaxLength" Value="10" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="Root" ColumnDefinitions="*" Background="{DynamicResource PageBackdropGradient}">
      <ScrollViewer x:Name="FormArea" HorizontalScrollBarVisibility="Disabled">
        <!-- Rows: brand band, card, links under it, room, motto. On a wide window the brand moves to
             its own column and the motto into it (LoginView.axaml.cs). -->
        <Grid x:Name="FormGrid" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- The brand: a band on a phone, the left half on a wide window -->
        <Border x:Name="Brand" Grid.Row="0" Background="{StaticResource BrandHeroGradient}" ClipToBounds="True">
            <Panel>
                <Ellipse Width="320" Height="320" Opacity="0.08" Fill="White" IsHitTestVisible="False"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-120,0" />
                <Ellipse Width="220" Height="220" Opacity="0.12" Fill="#FFD700" IsHitTestVisible="False"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-90,0,0,-110" />

                <StackPanel x:Name="BrandContent" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="16,28,16,48">
                    <!-- The app's logo, where the opening screen's logo lands (SplashView) -->
                    <Border x:Name="Logo" Width="88" Height="88" CornerRadius="26"
                            Background="{StaticResource BrandLogoGradient}"
                            BoxShadow="0 8 24 0 #40000000"
                            HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource LogoIcon}" Width="44" Height="44"
                                  Foreground="{StaticResource BrandPrimaryDarkBrush}" />
                    </Border>
                    <TextBlock x:Name="AppName" Text="AthloTrack" FontSize="30" FontWeight="ExtraBold"
                               Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock x:Name="Tagline" Text="Παρακολούθηση προόδου αθλητών" FontSize="14"
                               Foreground="#CFE3FF" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <!-- Release stage from <Version> in AthloTrack.csproj (e.g. 1.29-alpha); hidden for a stable release. -->
                    <Border IsVisible="{x:Static vm:AppInfo.IsPreRelease}" HorizontalAlignment="Center"
                            Background="#29FFFFFF" CornerRadius="10" Padding="10,3">
                        <TextBlock Text="{x:Static vm:AppInfo.Stage}" FontSize="11" FontWeight="Bold" Foreground="White" />
                    </Border>
                </StackPanel>
            </Panel>
        </Border>

                <!-- The card overlaps the band -->
                <Border x:Name="Card" Grid.Row="1" Margin="16,-28,16,0" MaxWidth="420"
                        Background="{DynamicResource CardBrush}" CornerRadius="22" Padding="20,18,20,20"
                        BoxShadow="0 12 32 0 #24003366">
                    <StackPanel Spacing="14">
                        <!-- Title, with ← on the inner steps -->
                        <Grid ColumnDefinitions="Auto,*" Margin="-10,-4,0,0">
                            <Button Classes="back" Command="{Binding BackCommand}" IsVisible="{Binding HasBack}"
                                    IsEnabled="{Binding !IsBusy}"
                                    AutomationProperties.Name="Πίσω" ToolTip.Tip="Πίσω">
                                <PathIcon Data="{StaticResource ArrowLeftIcon}" Width="20" Height="20" />
                            </Button>
                            <TextBlock Grid.Column="1" Text="{Binding FormTitle}" FontSize="20" FontWeight="ExtraBold"
                                       Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="10,0,0,0" />
                        </Grid>

                        <TextBlock IsVisible="{Binding IsSignUp}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrandSupportBrush}"
                                   Text="Χρησιμοποίησε το email που έδωσες στον προπονητή σου." />
                        <TextBlock IsVisible="{Binding IsForgot}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrandSupportBrush}"
                                   Text="Γράψε το email σου. Θα σου στείλουμε έναν κωδικό για να ορίσεις νέο κωδικό." />

                        <!-- Email -->
                        <StackPanel Spacing="6" IsVisible="{Binding ShowsEmail}">
                            <TextBlock Classes="label" Text="Email" />
                            <TextBox x:Name="EmailBox" Classes="field"
                                     Text="{Binding Email, Mode=TwoWay}"
                                     TextInputOptions.ContentType="Email"
                                     AutomationProperties.Name="Email" />
                        </StackPanel>

                        <!-- Κωδικός, with the eye that shows it -->
                        <StackPanel Spacing="6" IsVisible="{Binding ShowsPassword}">
                            <TextBlock Classes="label" Text="Κωδικός" />
                            <TextBox x:Name="PasswordBox" Classes="field revealPasswordButton"
                                     PasswordChar="●"
                                     Text="{Binding Password, Mode=TwoWay}"
                                     TextInputOptions.ContentType="Password"
                                     TextInputOptions.IsSensitive="True"
                                     AutomationProperties.Name="Κωδικός">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                        <Button Classes="link" HorizontalAlignment="Right" Margin="0,-10,-6,-8"
                                Content="Ξέχασα τον κωδικό" Command="{Binding ShowForgotCommand}"
                                IsVisible="{Binding IsSignIn}" IsEnabled="{Binding CanResetPassword}" />

                        <!-- «Επιβεβαίωσε το email σου»: whose profile, and where the code went -->
                        <StackPanel Spacing="10" IsVisible="{Binding IsVerifyLink}">
                            <TextBlock Text="{Binding LinkIntro}" FontSize="15" TextWrapping="Wrap"
                                       Foreground="{DynamicResource BrandSupportBrush}" LineHeight="22" />
                            <Border Background="{DynamicResource TintBrush}" CornerRadius="10" Padding="12,10">
                                <TextBlock Text="{Binding Email}" FontSize="15" FontWeight="ExtraBold"
                                           Foreground="{DynamicResource HeadingBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <!-- The 6-digit code (new password, or linking) -->
                        <StackPanel Spacing="6" IsVisible="{Binding IsCodeStep}">
                            <TextBlock Classes="label" Text="Κωδικός από το email" />
                            <TextBox x:Name="CodeBox" Classes="code" Text="{Binding Code, Mode=TwoWay}"
                                     TextInputOptions.ContentType="Digits"
                                     AutomationProperties.Name="Κωδικός από το email">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- New password -->
                        <StackPanel Spacing="14" IsVisible="{Binding IsResetCode}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="Νέος κωδικός" />
                                <TextBox Classes="field revealPasswordButton" PasswordChar="●"
                                         Text="{Binding NewPassword, Mode=TwoWay}"
                                         TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True"
                                         AutomationProperties.Name="Νέος κωδικός" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="Ξανά ο νέος κωδικός" />
                                <TextBox Classes="field revealPasswordButton" PasswordChar="●"
                                         Text="{Binding NewPasswordAgain, Mode=TwoWay}"
                                         TextInputOptions.ContentType="Password" TextInputOptions.IsSensitive="True"
                                         AutomationProperties.Name="Ξανά ο νέος κωδικός">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding InfoMessage}" Foreground="{DynamicResource LinkBrush}" TextWrapping="Wrap"
                                   IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <!-- Blue for sign-in and passwords, gold for the athlete's own steps -->
                        <Button Classes="primary login" Command="{Binding SubmitCommand}"
                                IsEnabled="{Binding !IsBusy}" IsVisible="{Binding !IsGoldButton}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <controls:Spinner IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SubmitText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="gold login" Command="{Binding SubmitCommand}"
                                IsEnabled="{Binding !IsBusy}" IsVisible="{Binding IsGoldButton}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <controls:Spinner IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SubmitText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- «Στείλε ξανά» under a code -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2" Margin="0,-6,0,-8"
                                    IsVisible="{Binding IsCodeStep}">
                            <TextBlock Text="Δεν ήρθε;" VerticalAlignment="Center" FontSize="14"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <Button Classes="link" Content="{Binding ResendText}" Command="{Binding ResendCommand}"
                                    IsEnabled="{Binding CanResend}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Under the card -->
                <StackPanel x:Name="UnderCard" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2" Margin="16,10,16,0">
                    <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsSignIn}">
                        <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding CanSignUp}">
                            <TextBlock Text="Νέος αθλητής;" VerticalAlignment="Center" FontSize="14"
                                       Foreground="{DynamicResource BrandSupportBrush}" />
                            <Button Classes="link" Content="Δημιουργία λογαριασμού" Command="{Binding ShowSignUpCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding IsSignUp}">
                        <TextBlock Text="Έχεις ήδη λογαριασμό;" VerticalAlignment="Center" FontSize="14"
                                   Foreground="{DynamicResource BrandSupportBrush}" />
                        <Button Classes="link" Content="Σύνδεση" Command="{Binding ShowSignInCommand}" />
                    </StackPanel>
                    <Button Classes="link" Content="Αποσύνδεση" Command="{Binding CancelLinkCommand}"
                            IsVisible="{Binding IsVerifyLink}"
                            Foreground="{DynamicResource BrandSupportBrush}" />
                </StackPanel>

                <!-- Bottom-center Greek motto -->
                <TextBlock x:Name="Motto" Grid.Row="4"
                           Text="νοῦς ὑγιής ἐν σώματι ὑγιεῖ"
                           FontFamily="{StaticResource GreekAccentFont}"
                           FontStyle="Italic" FontSize="18"
                           Foreground="{DynamicResource HeadingBrush}" Opacity="0.8"
                           HorizontalAlignment="Center" Margin="16,24,16,22" />
        </Grid>
      </ScrollViewer>
    </Grid>
</UserControl>
