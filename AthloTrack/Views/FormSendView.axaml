<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AthloTrack.ViewModels"
             xmlns:controls="using:AthloTrack.Views.Controls"
             x:Class="AthloTrack.Views.FormSendView"
             x:DataType="vm:FormSendViewModel">
    <!-- «Αποστολή σε…»: tick athletes or «Όλοι»; ones that already have the form stay greyed -->
    <Grid RowDefinitions="*,Auto" Margin="16">
        <ScrollViewer>
            <StackPanel Spacing="8">
                <TextBlock Text="Ο κάθε αθλητής παίρνει ειδοποίηση και συμπληρώνει το δικό του αντίγραφο."
                           TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" />
                <CheckBox Content="Όλοι" FontWeight="SemiBold" IsChecked="{Binding AllChecked}" Margin="0,6,0,0" />
                <Border Height="1" Background="{DynamicResource DividerBrush}" />
                <TextBlock Text="Δεν υπάρχουν αθλητές ακόμη." IsVisible="{Binding HasNobody}"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <ItemsControl ItemsSource="{Binding Athletes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FormSendAthlete">
                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanChoose}" Margin="0,4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <controls:Avatar Width="32" Height="32" CornerRadius="16" Initial="{Binding Initial}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock Text="· έχει σταλεί" IsVisible="{Binding AlreadySent}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
            <Button Content="Άκυρο" Command="{Binding CancelCommand}" Height="44" CornerRadius="22" Padding="20,0" VerticalContentAlignment="Center" />
            <Button Classes="primary" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:Spinner IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                    <TextBlock Text="Αποστολή" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
