<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AthloTrack.ViewModels"
             xmlns:controls="using:AthloTrack.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="640"
             x:Class="AthloTrack.Views.AddWorkoutView"
             x:DataType="vm:AddWorkoutViewModel">

    <UserControl.Styles>
        <!-- Παρών / Απών: outlined pills, filled green or red when chosen. Fluent's checked,
             pointer-over and pressed states replace a local Background, so restate them. -->
        <Style Selector="ToggleButton.presence">
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.presence.present">
            <Setter Property="BorderBrush" Value="#2E7D32" />
            <Setter Property="Foreground" Value="#2E7D32" />
        </Style>
        <Style Selector="ToggleButton.presence.absent">
            <Setter Property="BorderBrush" Value="#C62828" />
            <Setter Property="Foreground" Value="#C62828" />
        </Style>
        <Style Selector="ToggleButton.presence.present:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#142E7D32" />
            <Setter Property="BorderBrush" Value="#2E7D32" />
            <Setter Property="Foreground" Value="#2E7D32" />
        </Style>
        <Style Selector="ToggleButton.presence.absent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#14C62828" />
            <Setter Property="BorderBrush" Value="#C62828" />
            <Setter Property="Foreground" Value="#C62828" />
        </Style>
        <Style Selector="ToggleButton.presence.present:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2E7D32" />
            <Setter Property="BorderBrush" Value="#2E7D32" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="ToggleButton.presence.absent:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C62828" />
            <Setter Property="BorderBrush" Value="#C62828" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Header: athlete photo + title -->
        <!-- Grid, not a horizontal StackPanel: the title needs a width limit to wrap on a phone. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,16">
            <controls:Avatar Grid.Column="0" Width="52" Height="52" Photo="{Binding Photo}" Initial="{Binding Initial}" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                       VerticalAlignment="Center" Foreground="{StaticResource BrandPrimaryDarkBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14">
                <StackPanel Spacing="4">
                    <TextBlock Text="Ημ. ολοκλήρωσης" FontWeight="SemiBold" />
                    <controls:GreekDatePicker SelectedDate="{Binding TargetDate, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Παρουσία προπονητή (προαιρετικό)" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ToggleButton Classes="presence present" Content="● Παρών"
                                      IsChecked="{Binding IsPresentChosen, Mode=TwoWay}" />
                        <ToggleButton Classes="presence absent" Content="● Απών"
                                      IsChecked="{Binding IsAbsentChosen, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="Ασκησιολόγιο" FontWeight="SemiBold" />
                    <TextBox Text="{Binding Content, Mode=TwoWay}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="240"
                             PlaceholderText="Γράψε εδώ το πρόγραμμα προπόνησης..." />
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
            <Button Content="Άκυρο" Command="{Binding CancelCommand}" IsEnabled="{Binding !IsBusy}" Height="44" CornerRadius="22" Padding="20,0" VerticalContentAlignment="Center" />
            <Button Classes="primary" Content="Αποθήκευση" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
    </Grid>
</UserControl>
