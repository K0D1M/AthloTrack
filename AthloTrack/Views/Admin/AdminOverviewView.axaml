<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AthloTrack.ViewModels"
             x:Class="AthloTrack.Views.AdminOverviewView"
             x:DataType="vm:AdminOverviewViewModel">
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="16,20" Spacing="12" MaxWidth="720">

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- First load: tiles shaped like the numbers -->
                <!-- ItemsSource: six placeholder tiles (a string enumerates its characters). -->
                <ItemsControl IsVisible="{Binding ShowSkeleton}" ItemsSource="123456">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="kpi">
                                <StackPanel Spacing="8">
                                    <Border Classes="skeleton" Width="80" Height="10" HorizontalAlignment="Left" />
                                    <Border Classes="skeleton" Width="50" Height="22" HorizontalAlignment="Left" />
                                    <Border Classes="skeleton" Width="110" Height="10" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Numbers -->
                <ItemsControl ItemsSource="{Binding Kpis}" Classes="fadeitems" IsVisible="{Binding !ShowSkeleton}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AdminKpi">
                            <Border Classes="kpi">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource BrandSupportBrush}" />
                                    <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}" />
                                    <TextBlock Text="{Binding Detail}" Classes="admin-hint" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Health checks -->
                <TextBlock Text="Έλεγχοι" Classes="admin-section" IsVisible="{Binding !ShowSkeleton}" />
                <Border Classes="admincard" Padding="4,2" IsVisible="{Binding !ShowSkeleton}">
                    <ItemsControl ItemsSource="{Binding Checks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AdminHealthCheck">
                                <!-- Not disabled when there's nothing to fix (Fluent greys the whole row);
                                     the command ignores those. -->
                                <Button Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                        Padding="10,10"
                                        Command="{Binding $parent[UserControl].((vm:AdminOverviewViewModel)DataContext).OpenCheckCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                 Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding !HasIssues}" />
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                 Fill="#F59E0B" IsVisible="{Binding HasIssues}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Opacity="{Binding HasIssues, Converter={x:Static vm:AdminConverters.IssueOpacity}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource HeadingBrush}" />
                                        <PathIcon Grid.Column="3" Data="{StaticResource ChevronRightIcon}" Width="16" Height="16"
                                                  Foreground="{DynamicResource MutedTextBrush}" IsVisible="{Binding HasIssues}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Audit log -->
                <Button Command="{Binding OpenAuditCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="{DynamicResource TintBrush}" CornerRadius="12" Padding="14,12" Margin="0,4,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Ιστορικό ενεργειών διαχείρισης" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <PathIcon Grid.Column="1" Data="{StaticResource ChevronRightIcon}" Width="18" Height="18"
                                  Foreground="{DynamicResource MutedTextBrush}" />
                    </Grid>
                </Button>

                <!-- Latest activity -->
                <TextBlock Text="Πρόσφατη δραστηριότητα" Classes="admin-section" IsVisible="{Binding !ShowSkeleton}" />
                <ItemsControl ItemsSource="{Binding Activity}" Classes="fadeitems" IsVisible="{Binding !ShowSkeleton}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AdminActivityRow">
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="2,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        <TextBlock Classes="admin-hint">
                                            <Run Text="{Binding Kind}" /><Run Text=" · " /><Run Text="{Binding Who}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding When}" Classes="admin-hint" VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <ProgressBar Classes="topline" IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
    </Grid>
</UserControl>
