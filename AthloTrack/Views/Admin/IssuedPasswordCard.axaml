<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AthloTrack.ViewModels"
             x:Class="AthloTrack.Views.IssuedPasswordCard"
             x:DataType="vm:IssuedPassword">
    <!-- A temporary password, shown once: the admin passes it on; the app doesn't keep it. -->
    <Border Background="{DynamicResource NoticeBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="14">
        <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                <Run Text="Προσωρινός κωδικός για " /><Run Text="{Binding For}" />
            </TextBlock>
            <TextBlock Text="{Binding Email}" FontSize="13" Foreground="{DynamicResource BrandSupportBrush}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <SelectableTextBlock Text="{Binding Password}" FontSize="22" FontWeight="Bold"
                                     FontFamily="Consolas, Menlo, monospace" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="act" Click="OnCopy" ToolTip.Tip="Αντιγραφή">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource CopyIcon}" Width="16" Height="16" />
                        <TextBlock x:Name="CopyText" Text="Αντιγραφή" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Classes="admin-hint"
                       Text="Δώσε τον κωδικό στον χρήστη. Δεν θα ξαναεμφανιστεί· ο προπονητής θα ορίσει δικό του στην πρώτη σύνδεση." />
        </StackPanel>
    </Border>
</UserControl>
