<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AthloTrack.ViewModels"
             x:Class="AthloTrack.Views.AdminAuditView"
             x:DataType="vm:AdminAuditViewModel">
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="16,20" Spacing="12" MaxWidth="720">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="Καμία ενέργεια ακόμα." IsVisible="{Binding IsEmpty}"
                           Foreground="{DynamicResource BrandSupportBrush}" />
                <ItemsControl ItemsSource="{Binding Entries}" Classes="fadeitems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AdminAuditRow">
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="2,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Action}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Target}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Admin}" Classes="admin-hint" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding When}" Classes="admin-hint" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <ProgressBar Classes="topline" IsIndeterminate="True" IsVisible="{Binding IsLoading}" />
    </Grid>
</UserControl>
