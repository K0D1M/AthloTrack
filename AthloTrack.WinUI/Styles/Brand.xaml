<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ThemeDictionaries must be declared first in a ResourceDictionary -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- dark -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1F26" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#262A33" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6AEBF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SurfaceBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1D23" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B6472" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ============ Brand palette ============ -->
    <Color x:Key="BrandPrimaryColor">#1565C0</Color>
    <Color x:Key="BrandPrimaryDarkColor">#003366</Color>
    <Color x:Key="BrandAccentColor">#FFD700</Color>
    <Color x:Key="BrandSupportColor">#333333</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#1565C0" />
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="#003366" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="#FFD700" />
    <SolidColorBrush x:Key="BrandSupportBrush" Color="#333333" />

    <!-- ============ Signature gradients ============ -->
    <LinearGradientBrush x:Key="BrandHeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D47A1" Offset="0.0" />
        <GradientStop Color="#1565C0" Offset="0.45" />
        <GradientStop Color="#1E88E5" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD700" Offset="0.0" />
        <GradientStop Color="#FFA000" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandRailGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00224D" Offset="0.0" />
        <GradientStop Color="#003366" Offset="0.55" />
        <GradientStop Color="#0D47A1" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ============ Shape tokens ============ -->
    <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">22</CornerRadius>
    <Thickness x:Key="CardPadding">18</Thickness>

    <!-- ============ Control styles ============ -->
    <Style x:Key="BrandPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandHeroGradient}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="22,11" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="BrandAccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandAccentGradient}" />
        <Setter Property="Foreground" Value="#2A1A00" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="22,11" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="BrandGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="BrandCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>
</ResourceDictionary>
