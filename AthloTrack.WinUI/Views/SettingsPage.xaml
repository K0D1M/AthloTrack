<Page x:Class="AthloTrack.WinUI.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,26,32,26" Spacing="16" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="Ρυθμίσεις" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource BrandCard}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                            Background="{StaticResource BrandHeroGradient}">
                        <FontIcon Glyph="&#xE77B;" Foreground="#FFFFFF" FontSize="20" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Συνδεδεμένος ως" Style="{StaticResource CaptionText}" />
                        <TextBlock x:Name="UserText" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource BrandCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Γλώσσα / Language" FontWeight="SemiBold" />
                    <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Ελληνικά" />
                        <ComboBoxItem Content="English" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Button Content="Αποσύνδεση" Click="OnLogout" HorizontalAlignment="Left"
                    Style="{StaticResource BrandAccentButton}" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
