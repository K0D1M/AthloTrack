<Page x:Class="AthloTrack.WinUI.Views.WorkoutsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,26,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Προπονήσεις" Style="{StaticResource PageTitle}" Margin="0,0,0,18" />
        <ScrollViewer Grid.Row="1">
            <ItemsRepeater x:Name="List" Margin="0,0,0,26">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BrandCard}" Margin="0,0,0,10">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding AthleteName}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TargetDateText}" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
        <TextBlock x:Name="EmptyLabel" Grid.Row="1" Text="Δεν υπάρχουν ασκησιολόγια ακόμη."
                   Style="{StaticResource CaptionText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</Page>
