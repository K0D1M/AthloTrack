<Page x:Class="AthloTrack.WinUI.Views.AddMeasurementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Νέα μέτρηση" Style="{StaticResource PageTitle}" Margin="0,0,0,18" />

        <ScrollViewer Grid.Row="1">
            <Border Style="{StaticResource BrandCard}" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel Spacing="14">
                    <CalendarDatePicker x:Name="DatePicker" Header="Ημερομηνία" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="WeightBox" Header="Βάρος (kg) *" PlaceholderText="π.χ. 72.5" />
                    <TextBox x:Name="FatMassBox" Header="Fat Mass/WT" />
                    <TextBox x:Name="FatHgtBox" Header="fat/hgt" />
                    <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Άκυρο" Click="OnCancel" Style="{StaticResource BrandGhostButton}" />
            <Button x:Name="SaveButton" Content="Αποθήκευση" Click="OnSave"
                    Style="{StaticResource BrandPrimaryButton}" />
        </StackPanel>
    </Grid>
</Page>
