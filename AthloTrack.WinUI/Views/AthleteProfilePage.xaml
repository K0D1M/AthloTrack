<Page x:Class="AthloTrack.WinUI.Views.AthleteProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI">
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="32,22,32,110" Spacing="18">

                <!-- back -->
                <Button Click="OnBack" Style="{StaticResource BrandGhostButton}"
                        HorizontalAlignment="Left" Padding="14,7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="13" />
                        <TextBlock Text="Αθλητές" FontSize="13" />
                    </StackPanel>
                </Button>

                <!-- gradient profile header -->
                <Border CornerRadius="{StaticResource CardCornerRadius}"
                        Background="{StaticResource BrandHeroGradient}" Padding="26,22">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="66" Height="66" CornerRadius="22"
                                Background="{StaticResource BrandAccentGradient}">
                            <FontIcon Glyph="&#xE716;" FontSize="28" Foreground="#2A1A00" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                            <TextBlock x:Name="NameText" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="#CFE3FF" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" />

                <!-- progress chart -->
                <StackPanel x:Name="ChartSection" Spacing="10" Visibility="Collapsed">
                    <TextBlock Text="Πρόοδος" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource BrandCard}" Height="290">
                        <lvc:CartesianChart x:Name="Chart" LegendPosition="Bottom" />
                    </Border>
                </StackPanel>

                <!-- measurements -->
                <TextBlock Text="Μετρήσεις" Style="{StaticResource SectionTitle}" />
                <ItemsRepeater x:Name="MeasurementList">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource BrandCard}" Margin="0,0,0,8">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="14"
                                            Background="{StaticResource BrandAccentGradient}">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="17" Foreground="#2A1A00" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding MeasuredAt}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource CaptionText}">
                                            <Run Text="Βάρος: " /><Run Text="{Binding WeightKg}" /><Run Text=" kg" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock x:Name="NoMeasurements" Text="Καμία μέτρηση ακόμη."
                           Style="{StaticResource CaptionText}" Visibility="Collapsed" />

                <!-- workouts -->
                <TextBlock Text="Ασκησιολόγια" Style="{StaticResource SectionTitle}" Margin="0,8,0,0" />
                <ItemsRepeater x:Name="WorkoutList">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource BrandCard}" Margin="0,0,0,8">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="{Binding TargetDate}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock x:Name="NoWorkouts" Text="Κανένα ασκησιολόγιο ακόμη."
                           Style="{StaticResource CaptionText}" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!-- floating add -->
        <Button x:Name="AddButton" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,34,30" Width="58" Height="58" CornerRadius="29"
                Padding="0" BorderThickness="0"
                Background="{StaticResource BrandAccentGradient}">
            <FontIcon Glyph="&#xE710;" FontSize="21" Foreground="#2A1A00" />
            <Button.Flyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Νέα μέτρηση" Click="OnAddMeasurement">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Νέο ασκησιολόγιο" Click="OnAddWorkout">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE95E;" /></MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.Flyout>
        </Button>
    </Grid>
</Page>
