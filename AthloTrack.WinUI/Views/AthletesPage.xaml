<Page x:Class="AthloTrack.WinUI.Views.AthletesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,26,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Αθλητές" Style="{StaticResource PageTitle}" Margin="0,0,0,18" />

        <ScrollViewer Grid.Row="1">
            <ItemsRepeater x:Name="List" Margin="0,0,0,90">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="300" MinItemHeight="96"
                                       MinRowSpacing="12" MinColumnSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Padding="0" Background="Transparent" BorderThickness="0"
                                Click="OnAthleteClick" DataContext="{Binding}">
                            <Border Style="{StaticResource BrandCard}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="16"
                                            Background="{StaticResource BrandHeroGradient}">
                                        <FontIcon Glyph="&#xE716;" Foreground="#FFFFFF" FontSize="20" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{Binding FullName}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <TextBlock x:Name="EmptyLabel" Grid.Row="1" Text="Δεν υπάρχουν αθλητές ακόμη."
                   Style="{StaticResource CaptionText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

        <!-- floating gradient add button -->
        <Button x:Name="AddButton" Grid.Row="1" Click="OnAddClick"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,8,26" Width="56" Height="56" CornerRadius="28"
                Padding="0" BorderThickness="0"
                Background="{StaticResource BrandAccentGradient}">
            <FontIcon Glyph="&#xE710;" FontSize="20" Foreground="#2A1A00" />
        </Button>
    </Grid>
</Page>
