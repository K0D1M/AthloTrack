<Page x:Class="AthloTrack.WinUI.Views.RecentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="32,26,32,32" Spacing="20">

            <!-- gradient hero banner -->
            <Border CornerRadius="{StaticResource CardCornerRadius}"
                    Background="{StaticResource BrandHeroGradient}" Padding="28,24">
                <StackPanel>
                    <TextBlock x:Name="Welcome" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Καλή προπόνηση!" FontSize="14" Foreground="#CFE3FF" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- coach: most recent athlete -->
            <Border x:Name="RecentCard" Style="{StaticResource BrandCard}" Visibility="Collapsed">
                <StackPanel Spacing="6">
                    <TextBlock Text="Πιο πρόσφατος αθλητής" Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="RecentName" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="RecentSummary" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- athlete: notifications -->
            <StackPanel x:Name="NotifSection" Spacing="10" Visibility="Collapsed">
                <TextBlock Text="Ειδοποιήσεις" Style="{StaticResource SectionTitle}" />
                <ItemsRepeater x:Name="NotifList">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource BrandCard}" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock x:Name="NoNotif" Text="Καμία νέα ειδοποίηση."
                           Style="{StaticResource CaptionText}" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
