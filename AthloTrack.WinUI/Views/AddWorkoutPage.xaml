<Page x:Class="AthloTrack.WinUI.Views.AddWorkoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- gradient header with athlete avatar -->
        <Border Grid.Row="0" CornerRadius="{StaticResource CardCornerRadius}"
                Background="{StaticResource BrandHeroGradient}" Padding="22,18" Margin="0,0,0,18">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="17"
                        Background="{StaticResource BrandAccentGradient}">
                    <FontIcon Glyph="&#xE716;" FontSize="22" Foreground="#2A1A00" />
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center"
                           FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <Border Style="{StaticResource BrandCard}">
                <StackPanel Spacing="14">
                    <CalendarDatePicker x:Name="DatePicker" Header="Ημ. ολοκλήρωσης" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="ContentBox" Header="Ασκησιολόγιο"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="260"
                             PlaceholderText="Γράψε εδώ το πρόγραμμα προπόνησης..." />
                    <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Άκυρο" Click="OnCancel" Style="{StaticResource BrandGhostButton}" />
            <Button x:Name="SaveButton" Content="Αποθήκευση" Click="OnSave"
                    Style="{StaticResource BrandPrimaryButton}" />
        </StackPanel>
    </Grid>
</Page>
