<Page
    x:Class="AthloTrack.WinUI.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- ======= Hero panel: gradient brand side ======= -->
        <Grid Grid.Column="0" Background="{StaticResource BrandHeroGradient}">
            <!-- decorative glow -->
            <Ellipse Width="460" Height="460" Opacity="0.16"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-150,-170,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFFFF" Offset="0.0" />
                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="360" Height="360" Opacity="0.20"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-120,-140">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFD700" Offset="0.0" />
                        <GradientStop Color="#00FFD700" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel VerticalAlignment="Center" Margin="56,0">
                <Border Width="76" Height="76" CornerRadius="24"
                        Background="{StaticResource BrandAccentGradient}"
                        HorizontalAlignment="Left">
                    <FontIcon Glyph="&#xE95E;" FontSize="34" Foreground="#2A1A00" />
                </Border>

                <TextBlock Text="AthloTrack" FontSize="50" FontWeight="Bold"
                           Foreground="#FFFFFF" Margin="0,26,0,0" />
                <TextBlock Text="Παρακολούθηση προόδου αθλητών"
                           FontSize="17" Foreground="#CFE3FF" Margin="0,6,0,0" />

                <Rectangle Height="3" Width="72" RadiusX="2" RadiusY="2"
                           HorizontalAlignment="Left" Margin="0,28,0,0"
                           Fill="{StaticResource BrandAccentGradient}" />

                <TextBlock Text="νοῦς ὑγιής ἐν σώματι ὑγιεῖ"
                           FontSize="19" FontStyle="Italic"
                           Foreground="#EAF2FF" Margin="0,28,0,0" />
            </StackPanel>
        </Grid>

        <!-- ======= Form panel ======= -->
        <Grid Grid.Column="1" Background="{ThemeResource SurfaceBrush}">
            <StackPanel VerticalAlignment="Center" MaxWidth="360" Margin="44,0">

                <TextBlock Text="Καλώς ήρθες" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Συνδέσου για να συνεχίσεις"
                           Style="{StaticResource CaptionText}" Margin="0,6,0,0" />

                <!-- role selector -->
                <Grid Margin="0,28,0,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CoachToggle" Grid.Column="0" Click="OnSelectCoach"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource BrandPrimaryButton}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7EE;" FontSize="15" />
                            <TextBlock Text="Προπονητής" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AthleteToggle" Grid.Column="1" Click="OnSelectAthlete"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource BrandGhostButton}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C1;" FontSize="15" />
                            <TextBlock Text="Αθλητής" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBox x:Name="EmailBox" Header="Email" Margin="0,24,0,0"
                         PlaceholderText="name@mail.com"
                         Text="{x:Bind Vm.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <PasswordBox x:Name="PasswordBox" Header="Κωδικός" Margin="0,14,0,0"
                             PlaceholderText="••••••"
                             Password="{x:Bind Vm.Password, Mode=TwoWay}" />

                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False"
                         IsClosable="False" Margin="0,16,0,0" />

                <Button x:Name="SignInButton" Margin="0,22,0,0"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource BrandPrimaryButton}"
                        Click="OnSignIn">
                    <Grid>
                        <TextBlock x:Name="SignInLabel" Text="Είσοδος" />
                        <ProgressRing x:Name="SignInSpinner" IsActive="False" Visibility="Collapsed"
                                      Width="20" Height="20" Foreground="#FFFFFF" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
