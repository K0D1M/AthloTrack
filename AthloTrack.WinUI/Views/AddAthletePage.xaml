<Page x:Class="AthloTrack.WinUI.Views.AddAthletePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Νέος αθλητής" Style="{StaticResource PageTitle}" Margin="0,0,0,18" />

        <ScrollViewer Grid.Row="1">
            <Border Style="{StaticResource BrandCard}" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel Spacing="14">
                    <TextBox x:Name="NameBox" Header="Ονοματεπώνυμο *" PlaceholderText="π.χ. Γιώργος Παπαδόπουλος" />
                    <CalendarDatePicker x:Name="DobPicker" Header="Ημερομηνία γέννησης" HorizontalAlignment="Stretch" />
                    <TextBox x:Name="HeightBox" Header="Ύψος (cm)" PlaceholderText="π.χ. 178" />
                    <TextBox x:Name="NotesBox" Header="Σημειώσεις" AcceptsReturn="True" Height="96" TextWrapping="Wrap" />
                    <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Άκυρο" Click="OnCancel" Style="{StaticResource BrandGhostButton}" />
            <Button x:Name="SaveButton" Content="Αποθήκευση" Click="OnSave"
                    Style="{StaticResource BrandPrimaryButton}" />
        </StackPanel>
    </Grid>
</Page>
